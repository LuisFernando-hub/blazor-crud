@page "/employee-contacts"

@using BlazorCrud.Components.Pages.EmployeeContacts.Dialog
@using BlazorCrud.Dtos.Employee
@using BlazorCrud.Dtos.EmployeeContacts
@using BlazorCrud.Interface
@using Microsoft.AspNetCore.Authorization
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IEmployeeContactsService EmployeeContactsService
@attribute [Authorize]

<PageTitle>Employee Contacts</PageTitle>

<MudContainer Class="mt-16" MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Elevation="3" Class="pa-6 ma-4">
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-4">Employee Contacts</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                           Size="Size.Large" Class="ml-auto" OnClick="OpenCreateDialog">
                    New Employee Contact
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudDataGrid T="EmployeeContactDTO" Items="@_employeesContacts" Loading="@_loading" Hover="true" Dense="false"
                             Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="mud-primary-text">Contacts (@_employeesContacts.Count)</MudText>
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn Property="x => x.Type" Title="Type Contact">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudAvatar Color="Color.Secondary" Size="Size.Medium">@(context.Item.Type.ToString()[0])</MudAvatar>
                                    <MudText>@context.Item.Type</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Value" Title="Value">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Value</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Type" Title="Type Contact">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    @if (context.Item.IsPrimary)
                                    {
                                        <MudChip T="string" Color="Color.Success">Primary Contact</MudChip>
                                    } else {
                                        <MudChip T="string" Color="Color.Secondary">Secondary Contact</MudChip>
                                    }
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <TemplateColumn Title="Actions" TextAlignment="TextAlignment.Right">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0" Class="pa-2">
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                                       Size="Size.Small" Class="mx-1"
                                                       OnClick="@(() => OpenEditDialog(context.Item))" />
                                    </div>
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       Size="Size.Small" Class="mx-1"
                                                       OnClick="@(() => OpenDeleteDialog(context.Item.Id))" />
                                    </div>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.h6">Empty data.</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudDataGridPager T="EmployeeContactDTO" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code{
    private List<EmployeeContactDTO> _employeesContacts = new();
    private bool _loading = false;
    private readonly DialogOptions config = new() { FullWidth = true, CloseButton = true };


    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeeContacts();
    }

    private async Task LoadEmployeeContacts()
    {
        try
        {
            _loading = true;
            StateHasChanged();
            
            _employeesContacts = (await EmployeeContactsService.GetAllAsync()).ToList();

        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(EmployeeContactDTO employeeContact)
    {
        Console.WriteLine(employeeContact);
        var parameters = new DialogParameters
        {
            ["EmployeeContact"] = employeeContact,
            ["Title"] = $"Edit Employee Contact: {employeeContact.Type}" 
        };

        var dialog = await DialogService.ShowAsync<UpdateEmployeeContact>("Edit Employee Contact", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEmployeeContacts();
            Snackbar.Add("Employee Contact updated successfully", Severity.Success);
        }    
    }

    private async Task OpenDeleteDialog(Guid id)
    {
        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["Message"] = "Are you sure you want to delete this employee contacts? This action cannot be undone."
        };

        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await EmployeeContactsService.DeleteAsync(id);
                await LoadEmployeeContacts();
                Snackbar.Add("Employee Contact deleted successfully", Severity.Success);
            }
            catch (Exception)
            {
                Snackbar.Add("Failed to delete employee", Severity.Error);
            }
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateEmployeeContact>("Add New Employee Contact", config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEmployeeContacts();
            Snackbar.Add("Employee Contact created successfully", Severity.Success);
        }
    }
}