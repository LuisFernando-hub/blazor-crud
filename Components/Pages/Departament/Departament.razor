@page "/departament"
@using BlazorCrud.Components.Pages.Departament.Dialog
@using BlazorCrud.Dtos.Department
@using BlazorCrud.Interface
@using BlazorCrud.Request.Departament
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDepartamentService DepartamentService
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<PageTitle>Departaments</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Elevation="3" Class="pa-6 ma-4">
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-4">Departaments</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                           Size="Size.Large" Class="ml-auto" OnClick="OpenCreateDialog">
                    New Departament
                </MudButton>
            </MudItem>
        </MudGrid>
        <MudItem xs="12">
                @if (_loading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
                }
                
                <MudDataGrid T="DepartamentDTO" Items="@_departaments" Loading="@_loading" Hover="true" Dense="false"
                             Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="mud-primary-text">Departaments (@_departaments.Count)</MudText>
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn Property="x => x.Name" Title="Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudAvatar Color="Color.Secondary" Size="Size.Medium">@(context.Item.Name[0])</MudAvatar>
                                    <MudText>@context.Item.Name</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Name" Title="Description">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    @* <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small"></MudIcon> *@
                                    <MudText>@context.Item.Description</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CreatedAt" Title="CreatedAt" Format="MMM dd, yyyy" />
                        <TemplateColumn Title="Actions" TextAlignment="TextAlignment.Right">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0" Class="pa-2">
                                    
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                                       Size="Size.Small" Class="mx-1"
                                                       OnClick="@(() => OpenEditDialog(context.Item))"/>
                                    </div>
                                    <AuthorizeView Roles="Admin">
                                        <Authorized Context="authContext">
                                            <div>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                               Size="Size.Small" Class="mx-1"
                                                               OnClick="@(() => OpenDeleteDialog(context.Item.Id))"/>
                                            </div>
                                        </Authorized>
                                    </AuthorizeView>
                                </MudStack>
                            </CellTemplate>

                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="DepartamentDTO" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
    </MudPaper>
</MudContainer>

@code {
    private List<DepartamentDTO> _departaments = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private readonly DialogOptions config = new() { MaxWidth = MaxWidth.Medium, FullScreen = false, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartaments();
    }
    
    private async Task LoadDepartaments()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _departaments = (await DepartamentService.GetAllAsync()).ToList();
            
            Console.WriteLine($"Loaded {_departaments.Count} departaments");

        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load departaments", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(DepartamentDTO departament)
    {
        var parameters = new DialogParameters
        {
            ["Departament"] = departament,
            ["Title"] = $"Edit Departament:  {departament.Name}",
        };
        
        var dialog = await DialogService.ShowAsync<UpdateDepartament>("Edit Departament", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDepartaments();
            Snackbar.Add("Departament updated successfully", Severity.Success);
        }
    }

    private async Task OpenDeleteDialog(Guid id)
    {
        var parameters = new DialogParameters
        {
            ["Id"] = id,
            ["Message"] = "Are you sure you want to delete this departament?",
        };
        
        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await DepartamentService.DeleteAsync(id);
                await LoadDepartaments();
                Snackbar.Add("Departament deleted successfully", Severity.Success);
            }
            catch (Exception)
            {
                Snackbar.Add("Failed to delete departament", Severity.Error);
            }
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateDepartament>("Add New Departament", config);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            await LoadDepartaments();
            Snackbar.Add("Departament created successfully", Severity.Success);
        }
    }
}