@page "/employee-notes"
@using BlazorCrud.Components.Pages.EmployeeNotes.Dialog
@using BlazorCrud.Dtos.Employee
@using BlazorCrud.Dtos.EmployeeNotes
@using BlazorCrud.Interface
@using Microsoft.AspNetCore.Authorization
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IEmployeeNotesService EmployeeNotesService
@attribute [Authorize]

<PageTitle>Employee Notes</PageTitle>

<MudContainer Class="mt-16" MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Elevation="3" Class="pa-6 ma-4">
        <MudGrid>
            <MudItem xs="12" Class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-4">Employee Notes</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                           Size="Size.Large" Class="ml-auto" OnClick="OpenCreateDialog">
                    New Employee Note
                </MudButton>
            </MudItem>
            <MudItem xs="12">
                @if (_loading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4"/>
                }
                
                <MudDataGrid T="EmployeeNotesDTO" Items="@_employeesNotes" Loading="@_loading" Hover="true" Dense="false"
                             Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1" Filterable="true" QuickFilter="@_quickFilter">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="mud-primary-text">Notes (@_employeesNotes.Count)</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start"
                                      Immediate="true" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0">
                        </MudTextField>
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn Property="x => x.Employee.Name" Title="Employee Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Employee.Name</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Employee.Departament.Name" Title="Departament Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Employee.Departament.Name</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Content" Title="Content">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Content</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CreatedAt" Title="Created At" Format="MMM dd, yyyy" />
                        <TemplateColumn Title="Actions" TextAlignment="TextAlignment.Right">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0" Class="pa-2">
                                    <AuthorizeView Roles="Admin">
                                        <Authorized Context="authContext">
                                            <div>
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                                               Size="Size.Small" Class="mx-1"
                                                               OnClick="@(() => OpenEditDialog(context.Item))"/>
                                            </div>
                                
                                            <div>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                               Size="Size.Small" Class="mx-1"
                                                               OnClick="@(() => OpenDeleteDialog(context.Item.Id))"/>
                                            </div>
                                        </Authorized>
                                    </AuthorizeView>
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Primary"
                                                       Size="Size.Small" Class="mx-1"
                                                       OnClick="@(() => OpenDetailsEmployeeNoteDialog(context.Item))" />
                                    </div>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.h6">Empty data.</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudDataGridPager T="EmployeeNotesDTO" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>


@code {
    private List<EmployeeNotesDTO> _employeesNotes = new();
    private bool _loading = true;
    private readonly DialogOptions config = new() { FullWidth = true, CloseButton = true };
    private readonly DialogOptions _closeButton = new() { CloseButton = true };

    private string searchString1 = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesNotes();
    }
    
    private Func<EmployeeNotesDTO, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(searchString1))
            return true;

        if (x.Content.Contains(searchString1, StringComparison.OrdinalIgnoreCase))
            return true;
        
        if (x.Employee.Departament.Name.Contains(searchString1, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };

    private async Task LoadEmployeesNotes()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _employeesNotes = (await EmployeeNotesService.GetAllAsync()).ToList();

        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load employee notes", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditDialog(EmployeeNotesDTO employeeNote)
    {
        var parameters = new DialogParameters
        {
            ["EmployeeNote"] = employeeNote,
            ["Title"] = $"Edit Employee Note: {employeeNote.Content}",
        };

        var dialog = await DialogService.ShowAsync<UpdateEmployeeNotes>("Edit Employee Notes", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEmployeesNotes();
            Snackbar.Add("Employee Note updated successfully", Severity.Success);
        }
    }

    private async Task OpenDeleteDialog(Guid employeeNoteId)
    {
        var parameters = new DialogParameters
        {
            ["Id"] = employeeNoteId,
            ["Message"] = "Are you sure you want to delete this note? This action cannot be undone."
        };

        var dialog = await DialogService.ShowAsync<DeleteConfirmation>("Confirm Deletion", parameters, config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await EmployeeNotesService.DeleteAsync(employeeNoteId);
                await LoadEmployeesNotes();
                Snackbar.Add("Employee deleted successfully", Severity.Success);
            }
            catch (Exception)
            {
                Snackbar.Add("Failed to delete employee", Severity.Error);
            }
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateEmployeeNotes>("Add New Employee Note", config);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadEmployeesNotes();
            Snackbar.Add("Employee Note created successfully", Severity.Success);
        }
    }
    
    private async Task OpenDetailsEmployeeNoteDialog(EmployeeNotesDTO employeeNotes)
    {
        var parameters = new DialogParameters
        {
            ["Note"] = employeeNotes
        };
        
        var dialog = await DialogService.ShowAsync<DetailsEmployeeNotes>("Details", parameters, _closeButton);
        var result = await dialog.Result;
    }
}