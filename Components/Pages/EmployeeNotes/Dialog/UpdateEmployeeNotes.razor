@using BlazorCrud.Dtos.Employee
@using BlazorCrud.Dtos.EmployeeNotes
@using BlazorCrud.Interface
@using BlazorCrud.Request.EmployeeNotes
@using Microsoft.AspNetCore.Authorization
@inject IEmployeeService EmployeeService
@inject IEmployeeNotesService EmployeeNotesService
@inject ISnackbar Snackbar 
@inject IDialogService DialogService
@attribute [Authorize]

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@model">
            <MudSelect T="Guid" @bind-Value="model.EmployeeId" Variant="Variant.Outlined" Label="Employee"
                       Required="true" Placeholder="Select a Employee" RequiredError="Employee is required">
                <MudSelectItem T="Guid" Value="@Guid.Empty">
                    Select Employee
                </MudSelectItem>
                @foreach (var employee in _employees)
                {
                    <MudSelectItem T="Guid" Value="employee.Id">@employee.Name</MudSelectItem>
                }
            </MudSelect>
            
            <MudTextField Variant="Variant.Outlined" Lines="3" MaxLines="6" T="string" @bind-Value="model.Content" Label="Content" Required="true" RequiredError="Content is required"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default;

    private MudForm form = default;
    private UpdateEmployeeNotesRequest model = new();
    private List<EmployeeDTO> _employees = new();
    
    [Parameter] public EmployeeNotesDTO employeeNote { get; set; }
    [Parameter] public string Title { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }
    
    private async Task Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await EmployeeNotesService.UpdateAsync(model);
                Snackbar.Add("Employee Note Updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error updating employee note", Severity.Error);
            }
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            StateHasChanged();
            
            _employees = (await EmployeeService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading employees", Severity.Error);   
        }
    }
    
    protected override void OnInitialized()
    {
        model.Id = employeeNote.Id;
        model.EmployeeId = employeeNote.Employee.Id;
        model.Content = employeeNote.Content;
    }

}

