@page "/"
@using BlazorCrud.Components.Pages.EmployeeNotes.Dialog
@using BlazorCrud.Enums
@using BlazorCrud.Interface
@using Microsoft.AspNetCore.Authorization
@inject IEmployeeService EmployeeService
@inject IEmployeeNotesService EmployeeNotesService
@inject IDepartamentService DepartamentService
@using BlazorCrud.Dtos.EmployeeNotes
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<MudContainer Class="mt-16">
    <MudPaper Elevation="3" Class="pa-6 ma-4">
        <MudGrid Spacing="10">
            <MudItem xs="4">
                <MudPaper Elevation="3">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="100%"
                              Height="300px"
                              InputData="@EmployeesCount"
                              InputLabels="@EmployeeLabels"
                              >
                        <CustomGraphics>
                            <text class="mud-donut-text mud-typography-h3 hades-text text-white"
                                  x="50%"
                                  y="50%"
                                  text-anchor="middle"
                                  dominant-baseline="middle">
                                @EmployeesCount.Sum()
                            </text>
                        </CustomGraphics>
                    </MudChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Elevation="3">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="100%"
                              Height="300px"
                              InputData="@DepartamentsCount"
                              InputLabels="@DepartamentLabels">
                        <CustomGraphics>
                            <text class="mud-donut-text mud-typography-h3 hades-text text-white"
                                  x="50%"
                                  y="50%"
                                  text-anchor="middle"
                                  dominant-baseline="middle">
                                @DepartamentsCount.Sum()
                            </text>
                        </CustomGraphics>
                    </MudChart>
                </MudPaper>
            </MudItem>
            <MudItem xs="4">
                <MudPaper Elevation="3">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              Width="100%"
                              Height="300px"
                              InputData="@EmployeeNotesCount"
                              InputLabels="@EmployeeNotesLabels"
                              >
                        <CustomGraphics>
                            <text class="mud-donut-text mud-typography-h3 hades-text text-white"
                                  x="50%"
                                  y="50%"
                                  text-anchor="middle"
                                  dominant-baseline="middle">
                                @EmployeeNotesCount.Sum()
                            </text>
                        </CustomGraphics>
                    </MudChart>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>
    <MudPaper Elevation="3" Class="pa-6 ma-4">
        <MudGrid Spacing="10">
            <MudItem xs="12">
                <MudDataGrid T="EmployeeNotesDTO" Items="@EmployeeNotes" Loading="@_loading" Hover="true" Dense="false"
                             Striped="false" Bordered="false" ReadOnly="true" Class="elevation-1">
                    <Columns>
                        <PropertyColumn Property="x => x.Employee.Name" Title="Employee Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Employee.Name</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Employee.Departament.Name" Title="Departament Name">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Employee.Departament.Name</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        
                        <PropertyColumn Property="x => x.Content" Title="Content">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText>@context.Item.Content</MudText>
                                </MudStack>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CreatedAt" Title="Created At" Format="MMM dd, yyyy" />
                        <TemplateColumn Title="Actions" TextAlignment="TextAlignment.Right">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="0" Class="pa-2">
                                    <div>
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Primary"
                                                       Size="Size.Small" Class="mx-1"
                                                       OnClick="@(() => OpenDetailsEmployeeNoteDialog(context.Item))" />
                                    </div>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.h6">Empty data.</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private double[] EmployeesCount = [];
    private double[] DepartamentsCount = [];
    private double[] EmployeeNotesCount = [];
    private static string[] EmployeeLabels =
    [
        "Active",
        "Inactive"
    ];
    private static string[] DepartamentLabels = [
        "Departaments",
    ];
    private static string[] EmployeeNotesLabels = [
        "Notes"
    ];
    
    private bool _hidePosition;
    private bool _loading;
    private IEnumerable<EmployeeNotesDTO> EmployeeNotes = new List<EmployeeNotesDTO>();
    private readonly DialogOptions _closeButton = new() { CloseButton = true };


    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeeNotes();
        await LoadDataChart();
    }

    private async Task OpenDetailsEmployeeNoteDialog(EmployeeNotesDTO employeeNotes)
    {
        var parameters = new DialogParameters
        {
            ["Note"] = employeeNotes
        };
        
        var dialog = await DialogService.ShowAsync<DetailsEmployeeNotes>("Details", parameters, _closeButton);
    }

    private async Task LoadDataChart()
    {
        StateHasChanged();
        
        var departaments = await DepartamentService.GetAllAsync();
        var employees = await EmployeeService.GetAllAsync();
        
        if (!departaments.Any())
        {
            DepartamentLabels = ["Departaments"];
            DepartamentsCount = [0];
        }
        else
        {
            DepartamentLabels = departaments
                .Select(d => d.Name)
                .ToArray();
        
            DepartamentsCount = departaments
                .Select(d => (double)employees.Count(e => e.DepartamentId == d.Id))
                .ToArray();
        }
        
        EmployeesCount =
        [
            employees.Count(e => e.Status == EmployeeStatus.Active),
            employees.Count(e => e.Status == EmployeeStatus.Inactive),
        ];
        
        EmployeeNotesCount = [(double)EmployeeNotes.Count()];
    }

    private async Task LoadEmployeeNotes()
    {
        try
        {
            StateHasChanged();
            EmployeeNotes = (await EmployeeNotesService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error to loading employee notes", Severity.Error);
        }
    }
}