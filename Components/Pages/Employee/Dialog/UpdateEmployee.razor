@using BlazorCrud.Domain
@using BlazorCrud.Dtos.Department
@using BlazorCrud.Dtos.Employee
@using BlazorCrud.Interface
@using BlazorCrud.Enums
@using BlazorCrud.Request.Employee
@using Microsoft.AspNetCore.Authorization
@inject IEmployeeService EmployeeService
@inject IDepartamentService DepartamentService
@inject ISnackbar Snackbar 
@inject IDialogService DialogService
@attribute [Authorize]

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" Model="@model">
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="model.Name" Label="Employee" Required="true" RequiredError="Name is required"/>
            <MudSelect Variant="Variant.Outlined" T="Gender" Label="Gender" @bind-Value="model.Gender" Required="true" RequiredError="Gender is required!">
                @foreach (var gender in Enum.GetValues<Gender>())
                {
                    <MudSelectItem Value="gender">@gender</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="Guid" @bind-Value="model.DepartamentId" Variant="Variant.Outlined" Label="Departament"
                       Required="true" Placeholder="Select Departament" RequiredError="Departament is required">
                <MudSelectItem T="Guid" Value="@Guid.Empty">
                    Select Departament
                </MudSelectItem>
                @foreach (var departament in _departaments)
                {
                    <MudSelectItem T="Guid" Value="departament.Id">@departament.Name</MudSelectItem>
                }
            </MudSelect>
            
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="model.City" Label="City" Required="true" RequiredError="City is required"/>
            
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudSelect Variant="Variant.Outlined" T="EmployeeStatus" Label="Status" @bind-Value="model.Status">
                        @foreach (var status in Enum.GetValues<EmployeeStatus>())
                        {
                            <MudSelectItem Value="status">@status</MudSelectItem>
                        }
                    </MudSelect>
                </Authorized>
            </AuthorizeView>

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default;
    [Parameter] public EmployeeDTO employee { get; set; }
    [Parameter] public string Title { get; set; }
    
    private MudForm form;
    private UpdateEmployeeRequest model = new();
    private List<DepartamentDTO> _departaments = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartaments();
    }
    
    private async Task Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            try
            {
                await EmployeeService.UpdateAsync(model);
                Snackbar.Add("Employee Updated", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add("Error updating employee", Severity.Error);
            }
        }
    }

    private async Task LoadDepartaments()
    {
        try
        {
            StateHasChanged();
            
            _departaments = (await DepartamentService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error to loading departaments", Severity.Error);
        }
    }
    
    protected override void OnInitialized()
    {
        model.Id = employee.Id;
        model.DepartamentId = employee.DepartamentId;
        model.Name = employee.Name;
        model.Gender = employee.Gender;
        model.City = employee.City;
        model.Status = employee.Status;
    }

}

